{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "RunState": {
      "enum": [
        "queued",
        "running",
        "paused",
        "finished",
        "stopped",
        "failed"
      ],
      "type": "string"
    }
  },
  "description": "`POST /api/runs` response.",
  "properties": {
    "id": {
      "type": "string"
    },
    "seed": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "state": {
      "$ref": "#/definitions/RunState"
    }
  },
  "required": [
    "id",
    "seed",
    "state"
  ],
  "title": "RunCreated",
  "type": "object"
}
