{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "CamDetection": {
      "properties": {
        "bearing": {
          "description": "Bearing in the camera frame, radians (left positive).",
          "format": "double",
          "type": "number"
        },
        "camera_id": {
          "type": "string"
        },
        "captured_t": {
          "description": "Sim time the frame was captured (detections arrive after latency).",
          "format": "double",
          "type": "number"
        },
        "confidence": {
          "format": "double",
          "type": "number"
        },
        "distance_m": {
          "format": "double",
          "type": "number"
        },
        "kind": {
          "$ref": "#/definitions/DetectionKind"
        },
        "rings": {
          "items": {
            "$ref": "#/definitions/RingColor"
          },
          "maxItems": 5,
          "minItems": 5,
          "type": [
            "array",
            "null"
          ]
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/definitions/VictimStatus"
            },
            {
              "type": "null"
            }
          ],
          "description": "Reported status for smileys; for cognitive targets see `rings`."
        }
      },
      "required": [
        "bearing",
        "camera_id",
        "captured_t",
        "confidence",
        "distance_m",
        "kind"
      ],
      "type": "object"
    },
    "ColorReading": {
      "properties": {
        "ch": {
          "description": "AS7343 order: F1..F8, FZ, FY, FXL, NIR, Clear, Flicker. Raw counts.",
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 14,
          "minItems": 14,
          "type": "array"
        },
        "fresh": {
          "type": "boolean"
        },
        "sensor_id": {
          "type": "string"
        }
      },
      "required": [
        "ch",
        "fresh",
        "sensor_id"
      ],
      "type": "object"
    },
    "DetectionKind": {
      "enum": [
        "smiley",
        "cognitive"
      ],
      "type": "string"
    },
    "ImuReading": {
      "properties": {
        "accel": {
          "description": "Specific force, m/s^2.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "gyro": {
          "description": "Body rates, rad/s.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "pitch": {
          "format": "double",
          "type": "number"
        },
        "roll": {
          "description": "Fused roll/pitch/yaw, radians (zeros for `raw_imu`).",
          "format": "double",
          "type": "number"
        },
        "yaw": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "accel",
        "gyro",
        "pitch",
        "roll",
        "yaw"
      ],
      "type": "object"
    },
    "Pose3": {
      "description": "Full 3D pose. Angles in radians.",
      "properties": {
        "pitch": {
          "format": "double",
          "type": "number"
        },
        "roll": {
          "format": "double",
          "type": "number"
        },
        "x": {
          "format": "double",
          "type": "number"
        },
        "y": {
          "format": "double",
          "type": "number"
        },
        "yaw": {
          "format": "double",
          "type": "number"
        },
        "z": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "pitch",
        "roll",
        "x",
        "y",
        "yaw",
        "z"
      ],
      "type": "object"
    },
    "RingColor": {
      "enum": [
        "black",
        "red",
        "yellow",
        "green",
        "blue"
      ],
      "type": "string"
    },
    "TofReading": {
      "properties": {
        "fresh": {
          "description": "True when this step carries a new sample.",
          "type": "boolean"
        },
        "sensor_id": {
          "type": "string"
        },
        "status": {
          "items": {
            "format": "uint8",
            "minimum": 0.0,
            "type": "integer"
          },
          "type": "array"
        },
        "zones": {
          "description": "Row-major zones, `resolution^2` long. Millimeters.",
          "items": {
            "format": "uint16",
            "minimum": 0.0,
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "fresh",
        "sensor_id",
        "status",
        "zones"
      ],
      "type": "object"
    },
    "VictimStatus": {
      "enum": [
        "harmed",
        "stable",
        "unharmed"
      ],
      "type": "string"
    },
    "WheelState": {
      "properties": {
        "actual": {
          "format": "double",
          "type": "number"
        },
        "cmd": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "actual",
        "cmd"
      ],
      "type": "object"
    }
  },
  "properties": {
    "cams": {
      "items": {
        "$ref": "#/definitions/CamDetection"
      },
      "type": "array"
    },
    "color": {
      "items": {
        "$ref": "#/definitions/ColorReading"
      },
      "type": "array"
    },
    "id_light": {
      "type": "boolean"
    },
    "imu": {
      "$ref": "#/definitions/ImuReading"
    },
    "pose": {
      "allOf": [
        {
          "$ref": "#/definitions/Pose3"
        }
      ],
      "description": "Ground-truth pose."
    },
    "t": {
      "format": "double",
      "type": "number"
    },
    "tof": {
      "description": "Only sensors that produced a fresh sample since the previous frame.",
      "items": {
        "$ref": "#/definitions/TofReading"
      },
      "type": "array"
    },
    "wheels": {
      "items": {
        "$ref": "#/definitions/WheelState"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    }
  },
  "required": [
    "cams",
    "color",
    "id_light",
    "imu",
    "pose",
    "t",
    "tof",
    "wheels"
  ],
  "title": "Frame",
  "type": "object"
}
